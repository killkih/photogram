p
  = @user.email
  br
  = @user.nickname
  br
  - if @user.first_name.present?
    = @user.first_name
    br

  - if @user.last_name.present?
    = @user.last_name
    br

  - if @user.bio.present?
    = @user.bio
    br

  - if current_user.present? && @user != current_user && !current_user.friends.include?(@user)
    = button_to 'Subscribe', subscribe_profile_path(@user.id), method: :post, remote: true, class: 'btn btn-primary'

p Your Posts:

- @user.posts.sort_by_date.each do |n|
  = image_tag n.content
  p= n.body
  = link_to 'View', post_path(n), remote: true, class: "btn btn-primary"
  br
